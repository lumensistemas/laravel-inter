{
    "name": "lumensistemas/laravel-inter",
    "description": "A Laravel package for integrating with Banco Inter API.",
    "keywords": [
        "lumensistemas",
        "laravel-inter",
        "banco-inter",
        "api-integration",
        "laravel"
    ],
    "homepage": "https://github.com/lumensistemas/laravel-inter",
    "license": "MIT",
    "authors": [
        {
            "name": "Lucas Vasconcelos",
            "email": "lucasvscn@pm.me",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0"
    },
    "require-dev": {
        "beyondcode/expose": "^3.2",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.55",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-faker": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/phpstan": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "LumenSistemas\\Inter\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LumenSistemas\\Inter\\Tests\\": "tests"
        }
    },
    "scripts": {
        "agent:analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --error-format=json --memory-limit=512M",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": ["rector process --memory-limit=512M", "pint"],
        "test": "pest --bail",
        "test:type-coverage": "pest --type-coverage --min=100 --memory-limit=512M",
        "test:arch": "pest --testsuite=Arch",
        "test:unit": "pest --testsuite=Unit",
        "test:feature": "pest --testsuite=Feature",
        "test:integration": "pest --testsuite=Integration",
        "test:coverage": "pest --coverage --min=90 --exclude-testsuite=Integration",
        "test:lint": ["rector process --dry-run --clear-cache --memory-limit=512M", "pint --test"],
        "test:all": ["@test:lint", "@analyse", "@test:type-coverage", "@test:coverage"],
        "webhook:serve": "php -S 0.0.0.0:8008 scripts/webhook-server.php",
        "webhook:register": "php scripts/register-webhook.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LumenSistemas\\Inter\\InterServiceProvider"
            ],
            "aliases": {
                "Inter": "LumenSistemas\\Inter\\Facades\\Inter"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
